{
  "name": "nano-emitter",
  "version": "1.0.0",
  "description": "Tiny event emitter with priorities, async emission, and pattern listeners.",
  "author": "npclfg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npclfg/nano-emitter.git"
  },
  "bugs": {
    "url": "https://github.com/npclfg/nano-emitter/issues"
  },
  "homepage": "https://github.com/npclfg/nano-emitter#readme",
  "main": "./dist/cjs/nanoemitter.js",
  "module": "./dist/esm/nanoemitter.js",
  "types": "./dist/cjs/nanoemitter.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/cjs/nanoemitter.d.ts",
        "default": "./dist/esm/nanoemitter.js"
      },
      "require": {
        "types": "./dist/cjs/nanoemitter.d.ts",
        "default": "./dist/cjs/nanoemitter.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "npm run build && node test/run.js",
    "verify": "npm run build && node scripts/verify.js",
    "bench": "npm run build && node benchmark/bench.js",
    "sample": "npm run build && node sample/app.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "events",
    "emitter",
    "pubsub",
    "async",
    "priority",
    "pattern",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
